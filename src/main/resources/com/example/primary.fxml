<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.Controller"
      stylesheets="@style.css"
      styleClass="mainParent">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <children>
        <VBox styleClass="sidebar" prefWidth="260" spacing="12.0">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <children>
                <Label text="CHATS" styleClass="sidebarTitle"/>

                <Button text="+ New Chat"
                        onAction="#handleNewChat"
                        maxWidth="Infinity"
                        styleClass="newChatButton"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparentScroll">
                    <content>
                        <VBox fx:id="historyContainer" spacing="8.0"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="chatAreaContainer">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparentScroll">
                    <content>
                        <VBox fx:id="chatContainer" spacing="14.0">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="12"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox spacing="10.0" alignment="CENTER" styleClass="inputBar">
                    <padding>
                        <Insets top="6" right="6" bottom="6" left="18"/>
                    </padding>
                    <children>
                        <TextField fx:id="Inputfield"
                                   promptText="Ask anything..."
                                   onAction="#handleButtonClick"
                                   styleClass="inputText"
                                   HBox.hgrow="ALWAYS"
                                   prefHeight="48"/>

                        <Button text="Send"
                                onAction="#handleButtonClick"
                                prefHeight="48"
                                prefWidth="96"
                                styleClass="sendButton"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>